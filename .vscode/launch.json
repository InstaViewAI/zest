{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // Credentials come from the untracked config/secret.local.yaml — never inline here.
      // Copy config/secret.local.sample.yaml to config/secret.local.yaml and fill it in first.
      "name": "Zest",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "local",
        "CONFIG_FILE_PATH": "config/config.local.yaml",
        "SECRET_FILE_PATH": "config/secret.local.yaml"
      }
    },
    {
      // Attach to an already-running server, e.g. one started by `make run`.
      "name": "Attach to Zest",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    }
  ]
}
