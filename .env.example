# Copy to .env and fill in. .env is gitignored.
ENVIRONMENT=local
SERVER_PORT=8080

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
# Channel ID (C...), never a channel name. Right-click channel -> Copy Link.
SLACK_CHANNEL_ID=C0123456789
SLACK_BOT_NAME=ZEST
SLACK_REPORT_BOT_NAME=ZEST - Weekly Report
SLACK_ICON_URL=https://partner-assets-worker.infra-dev.workers.dev/slackBot.png

# --- Zendesk ---
ZENDESK_SUBDOMAIN=instaviewhomesupport
ZENDESK_EMAIL=you@instaview.ai
ZENDESK_API_TOKEN=...
# Signing secret from the Zendesk webhook. Leave empty ONLY for local dev.
ZENDESK_WEBHOOK_SECRET=

# --- Escalation join key ---
ESCALATION_TAG=escalated
# Numeric field IDs of the slack_thread_ts / slack_channel_id custom fields.
ZENDESK_FIELD_SLACK_THREAD_TS=0
ZENDESK_FIELD_SLACK_CHANNEL_ID=0

# --- Reports ---
REPORT_STALE_AFTER=168h
REPORT_TIMEZONE=Asia/Manila
REPORT_WEEKLY_ENABLED=true
REPORT_WEEKLY_CRON=30 1 * * 6
REPORT_MONTHLY_ENABLED=false
REPORT_MONTHLY_CRON=30 1 1 * *
